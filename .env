# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.loidbrganuqvbyidzcba:Yokcy1iIBypyzvfV@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres"
DB_POOL_SIZE=10
DB_STATEMENT_TIMEOUT_MS=10000

# ── Server ────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
# Public base URL of THIS API (used to build short links: {APP_URL}/r/{code})
APP_URL=http://localhost:3001
# Set to true ONLY when running behind a reverse proxy / the Next.js proxy you control.
# When false, rate limiting uses the real socket IP and ignores X-Forwarded-For.
TRUST_PROXY=false

# ── Security ──────────────────────────────────────────────
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=123
# Devices must send this to POST /devices/register. If empty, registration is OPEN.
REGISTRATION_SECRET=
# Comma separated origins allowed to call the API from a browser. Not needed when using the Next.js proxy.
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# ── Application ───────────────────────────────────────────
# development enables /openapi docs and permissive CORS
APP_ENV=production
APP_DEBUG=false
TIMEZONE=Asia/Manila
MAX_SMS_LENGTH=918
MAX_BULK_SIZE=500
SMS_RETRY_MAX=3
DEVICE_OFFLINE_THRESHOLD=300

# ── Background jobs (replaces cron.php) ───────────────────
# Runs inside the API process every minute. Turn off on all but one instance when scaling out.
CRON_ENABLED=true
